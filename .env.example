# =================================================================
# TeamSync ToDo - Environment Configuration (.env)
# =================================================================
# Copy this file to .env and adjust the values for your server.
# All variables can be configured directly in Portainer (Stack Environment).

# -----------------------------------------------------------------
# 1. Serverpod Server Settings
# -----------------------------------------------------------------
SERVERPOD_RUN_MODE=production
SERVERPOD_SERVER_ID=default
SERVERPOD_SERVER_ROLE=monolith
SERVERPOD_LOGGING_MODE=normal
SERVERPOD_APPLY_MIGRATIONS=true

# -----------------------------------------------------------------
# 2. Public Domain & Port Configuration
# -----------------------------------------------------------------
# The public domain where clients and browsers connect to your server
SERVERPOD_API_SERVER_PUBLIC_HOST=todo.example.com
SERVERPOD_API_SERVER_PUBLIC_PORT=443
SERVERPOD_API_SERVER_PUBLIC_SCHEME=https
SERVERPOD_API_SERVER_PORT=8080

# Web App Port & Host
SERVERPOD_WEB_SERVER_PORT=8082

# -----------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# -----------------------------------------------------------------
POSTGRES_DB=todolist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToASecurePassword2026!

SERVERPOD_DATABASE_HOST=db
SERVERPOD_DATABASE_PORT=5432
SERVERPOD_DATABASE_NAME=todolist
SERVERPOD_DATABASE_USER=postgres
SERVERPOD_DATABASE_REQUIRE_SSL=false
SERVERPOD_PASSWORD_database=ChangeThisToASecurePassword2026!

# -----------------------------------------------------------------
# 4. Security & Auth Secrets
# -----------------------------------------------------------------
# Secret token used by Serverpod internally for authentication validation
SERVICE_SECRET=ChangeThisToASecretServiceKey2026_XYZ!

# Serverpod 4 JWT Authentication Keys & Peppers:
JWT_REFRESH_PEPPER=xtxwqR-2dMf1MfTc91ziWZQQIoG1OSJF
JWT_PRIVATE_KEY=dCle2CzkOCJyMvTwvtr4-GnSuik-qpKX
EMAIL_SECRET_PEPPER=BKvLQw22SWrFlWnfZSO-Kd7iGglf-VYr

# -----------------------------------------------------------------
# 5. Flutter Client URL (Optional Override)
# -----------------------------------------------------------------
API_URL=https://todo.example.com/
